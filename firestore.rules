rules_version = '2';

// =========================================================
// Regras de segurança — Finanças da Casa
// Cole isso em: Firebase Console > Firestore Database > Regras
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehSirlene() {
      return request.auth.token.email == "sirlene@financas-casa.app";
    }

    // e-mail do próprio integrante, baseado na chave (junior, sirlene, giovana, kevin)
    function emailDoIntegrante(chave) {
      return chave + "@financas-casa.app";
    }

    match /meses/{mesId} {
      // Qualquer um dos 4 integrantes logados pode ver tudo
      allow read: if logado();

      // Criação do documento do mês (reinício mensal automático) — qualquer integrante logado
      allow create: if logado();

      // Atualização: qualquer integrante logado pode marcar/desfazer contas e contribuir.
      // Só a Sirlene pode alterar nome/descrição/meta do Extra.
      allow update: if logado() && (
        !("extra" in request.resource.data.diff(resource.data).affectedKeys()) ||
        ehSirlene() ||
        // permite que qualquer um incremente extra.arrecadado sem mexer em nome/descricao/meta
        (
          request.resource.data.extra.nome == resource.data.extra.nome &&
          request.resource.data.extra.descricao == resource.data.extra.descricao &&
          request.resource.data.extra.meta == resource.data.extra.meta
        )
      );

      allow delete: if false;
    }
  }
}
